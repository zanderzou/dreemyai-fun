---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { comparisonCopy, comparisonKeys } from "../data/localized-articles";
import { localizedUi } from "../data/localized-ui";
import type { SiteLocale } from "../data/locale-routes";
interface Props { posts: CollectionEntry<"blog">[]; locale?:SiteLocale; }
const { posts, locale="en" } = Astro.props;
const copy=locale==="en"?null:localizedUi[locale];
const base=locale==="en"?"/":`/${locale}/`;
---
<footer>
  <div class="footer-grid">
    <div><a class="brand" href={base}><span class="brand-icon">D</span><strong>DREEMY<span>AI</span></strong></a><p>{copy?.summary??"Independent research on Dreemy AI roleplay, character discovery, bot creation, image and video tools, privacy, credits, and alternatives."}</p></div>
    <div><h3>{copy?.explore??"Explore"}</h3><a href={`${base}#features`}>{copy?.features??"Dreemy AI features"}</a><a href={`${base}#compare`}>{copy?.compare??"Compare alternatives"}</a><a href={`${base}#privacy`}>{copy?.privacy??"Privacy checklist"}</a><a href={site.officialUrl} rel="noopener" target="_blank">{copy?.official??"Official website"} <Icon name="arrow" /></a></div>
    <div><h3>{copy?.latest??"Latest guides"}</h3>{locale==="en"?posts.slice(0,3).map((post)=><a href={`/blog/${post.id}/`}>{post.data.title}</a>):comparisonKeys.slice(0,3).map((key)=><a href={`${base}blog/dreemy-ai-vs-${key}/`}>{comparisonCopy[locale]![key].title}</a>)}</div>
    <div><h3>{copy?.information??"Information"}</h3><a href={`${base}about/`}>{copy?.about??"About"}</a><a href={`${base}privacy/`}>{copy?.privacy??"Privacy"}</a><a href={`${base}terms/`}>{copy?.terms??"Terms"}</a><a href={`${base}editorial-policy/`}>{copy?.editorial??"Editorial policy"}</a><a href={`${base}contact/`}>{copy?.contact??"Contact"}</a></div>
  </div>
  <div class="footer-bottom"><span>© <span data-year>2026</span> Dreemy AI</span><span>{copy?.independent??"Independent · Not affiliated with Dreemy AI"}</span><span>{copy?.noUploads??"Adults only · No chat data collected"}</span></div>
</footer>
